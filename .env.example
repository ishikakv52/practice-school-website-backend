NODE_ENV=development
PORT=5000

# CORS: the origin your Next.js frontend runs on
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_website
DB_USER=root
DB_PASSWORD=

# External APIs — filled in during later phases.
# These stay server-side only. Never copy them into the Next.js frontend's
# .env (only NEXT_PUBLIC_* values there, and only non-secret ones like a
# Maps *browser* key restricted by domain, if you choose to call Maps
# directly from the client).
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=
YOUTUBE_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

EMAIL_API_KEY=

# SMTP (Nodemailer) — alternative to a hosted email API above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=school@example.com
# Where new enquiries/admissions notify the school office (not the applicant)
SCHOOL_NOTIFY_EMAIL=

SMS_API_KEY=
WHATSAPP_API_KEY=

AI_API_KEY=

RECAPTCHA_SECRET_KEY=

# Auth (added when the auth phase is built)
JWT_SECRET=
JWT_EXPIRES_IN=7d
